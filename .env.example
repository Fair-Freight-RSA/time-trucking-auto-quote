VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Server-side Supabase Edge Function secrets. Do not expose these in browser code.
APP_PUBLIC_URL=https://your-production-domain.example
ALLOWED_ORIGINS=https://your-production-domain.example,http://localhost:4174
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=quotes@your-domain.example
EMAIL_FROM_NAME=Time Trucking
EMAIL_DRY_RUN=false
RESEND_API_KEY=server_only_resend_key
SENDGRID_API_KEY=server_only_sendgrid_key
POSTMARK_SERVER_TOKEN=server_only_postmark_token
SUPABASE_SERVICE_ROLE_KEY=server_only_supabase_service_role_key
